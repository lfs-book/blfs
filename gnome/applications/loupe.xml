<sect1 id="loupe" xreflabel="Loupe-&loupe-version;">
  <?dbhtml filename="loupe.html"?>


  <title>Loupe-&loupe-version;</title>

  <indexterm zone="loupe">
    <primary sortas="a-Loupe">Loupe</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to Loupe</title>

    <para>
      <application>Loupe</application> is an application used for
      viewing image files on the <application>GNOME</application> Desktop.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Package Information</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download (HTTP): <ulink url="&loupe-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Download (FTP): <ulink url="&loupe-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Download MD5 sum: &loupe-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Download size: &loupe-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimated disk space required: &loupe-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Estimated build time: &loupe-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Loupe Dependencies</bridgehead>

    <bridgehead renderas="sect4">Required</bridgehead>
    <para role="required">
      <xref linkend="lcms2"/>,
      <xref linkend="libadwaita"/>,
      <xref linkend="libgweather"/>, and
      <xref linkend="libseccomp"/>
    </para>

    <bridgehead renderas="sect4">Optional</bridgehead>
    <para role="optional">
      <xref linkend="appstream"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installation of Loupe</title>

    <para>
      Install <application>Loupe</application> by running the
      following commands:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      To test the results, issue: <command>ninja test</command>
    </para>

    <para>
      Now, as the <systemitem class="username">root</systemitem> user:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

